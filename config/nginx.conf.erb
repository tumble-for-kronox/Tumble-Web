events {
    worker_connections 1024;  # This line specifies the number of connections per worker.
}

http {
    include       mime.types;  # Include this line to set MIME types correctly
    default_type  application/octet-stream;

    # Expires map
    map $sent_http_content_type $expires {
        default                    off;
        text/html                  epoch;
        text/css                   max;
        application/json           max;
        application/javascript     max;
        ~image/                    max;
    }

    # Redirect logs to standard output and error
    error_log /dev/stderr;
    access_log /dev/stdout;

    server {
        listen $PORT;
        location / {
            root /usr/share/nginx/html;
            index index.html index.htm;
            try_files $uri $uri/ /index.html =404;
        }
        expires $expires;
        gzip on;
    }
}
